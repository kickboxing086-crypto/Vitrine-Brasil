rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidListing(data) {
      return data.keys().hasAll(['title', 'category', 'platform', 'link', 'plan', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.link is string && data.link.size() > 0 && data.link.size() <= 1000 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.platform is string && data.platform.size() > 0 && data.platform.size() <= 50 &&
             data.plan is string && data.plan in ['bronze', 'prata', 'ouro', 'diamante'] &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 60)) &&
             (!('status' in data) || (data.status is string && data.status in ['pending', 'approved'])) &&
             (!('clicks' in data) || (data.clicks is number && data.clicks >= 0)) &&
             (!('memberCount' in data) || (data.memberCount is number && data.memberCount >= 0)) &&
             (!('expiresAt' in data) || data.expiresAt is timestamp) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 100)) &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128));
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if 
        // Flow A: Guest (any user) submits a pending listing
        (
          incoming().status == 'pending' &&
          incoming().clicks == 0 &&
          incoming().memberCount == 0 &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          isValidListing(incoming())
        ) ||
        // Flow B: Authenticated Admin creates any listing (approved or pending)
        (
          isSignedIn() &&
          incoming().createdAt is timestamp &&
          incoming().updatedAt is timestamp &&
          isValidListing(incoming())
        );
      allow update: if 
        // Flow A: Authenticated Admin updates any listing
        (
          isSignedIn() &&
          incoming().updatedAt == request.time &&
          isValidListing(incoming())
        ) ||
        // Flow B: Anyone increments the clicks count
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['clicks']) &&
          incoming().clicks == existing().get('clicks', 0) + 1
        );
      allow delete: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
